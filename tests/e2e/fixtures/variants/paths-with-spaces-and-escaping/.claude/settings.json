{
  "permissions": {
    "allow": ["Bash(make lint)"],
    "deny": ["Bash(rm -rf /)"],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/my hook.sh --msg \"hello world\"" }
        ]
      }
    ]
  }
}
